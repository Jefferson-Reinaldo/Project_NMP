<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarFormQuestion"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="Tambah Soal Baru"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIcon="@android:drawable/ic_menu_revert" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Spinner Kategori Soal -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih Kategori Ujian:"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <Spinner
                    android:id="@+id/spinnerCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingHorizontal="12dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Input Teks Pertanyaan (OutlinedBox) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputQuestionText"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="Teks Pertanyaan Soal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputQuestionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Pilihan A -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputOptionA"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Pilihan A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputOptionA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Pilihan B -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputOptionB"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Pilihan B">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputOptionB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Pilihan C -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputOptionC"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Pilihan C">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputOptionC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Pilihan D -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputOptionD"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Pilihan D">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputOptionD"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Kunci Jawaban Benar (RadioGroup) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kunci Jawaban Benar:"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <RadioGroup
                android:id="@+id/radioGroupKeyAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbKeyA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Opsi A" />

                <RadioButton
                    android:id="@+id/rbKeyB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Opsi B" />

                <RadioButton
                    android:id="@+id/rbKeyC"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Opsi C" />

                <RadioButton
                    android:id="@+id/rbKeyD"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Opsi D" />
            </RadioGroup>

            <!-- Input URL Gambar (Optional) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputImageUrl"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="URL Gambar Pendukung (Opsional)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtInputImageUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Status Aktif (CheckBox) -->
            <CheckBox
                android:id="@+id/cbIsActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:checked="true"
                android:text="Aktifkan soal ini untuk ujian peserta"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <!-- Tombol Simpan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveQuestion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Simpan Soal"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <ProgressBar
                android:id="@+id/progressBarSaveQuestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>