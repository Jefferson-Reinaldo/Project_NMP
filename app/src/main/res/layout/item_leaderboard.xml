<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Kotak Skor -->
        <LinearLayout
            android:id="@+id/layoutScoreBadge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/colorPrimaryContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtScoreValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <TextView
                android:id="@+id/txtTotalQuestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/ 10 Soal"
                android:textSize="10sp"
                android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtCategoryNameScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Nama Kategori Ujian"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layoutScoreBadge"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtParticipantName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:text="Peserta: Budi Santoso"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layoutScoreBadge"
            app:layout_constraintTop_toBottomOf="@id/txtCategoryNameScore" />

        <TextView
            android:id="@+id/txtScoreDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:text="Tanggal: 2026-11-25 10:00"
            android:textSize="11sp"
            android:textColor="?attr/colorOutline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/layoutScoreBadge"
            app:layout_constraintTop_toBottomOf="@id/txtParticipantName" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>